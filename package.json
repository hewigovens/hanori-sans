{
  "name": "hanori-sans-build",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "fetch": "node tools/hanori.ts fetch",
    "build": "node --max-old-space-size=4096 tools/hanori.ts build",
    "check": "tsc --noEmit",
    "test": "npm run check && node --test tools/fonts.test.ts tools/analysis.test.ts && npm run verify",
    "verify": "node --max-old-space-size=4096 tools/hanori.ts verify",
    "verify:native": "node tools/hanori.ts test-app --unit",
    "app": "node tools/hanori.ts app",
    "test:app": "node tools/hanori.ts test-app",
    "build:extension": "npm run check && node tools/extension.ts",
    "test:extension": "npm run build:extension && node --test tools/analysis.test.ts tools/extension.test.ts",
    "build:safari": "npm run check && node tools/hanori.ts safari",
    "test:safari": "npm run check && node --test tools/safari.test.ts",
    "package:release": "node tools/release.ts",
    "package:extension": "npm run check && node tools/pack-extension.ts",
    "release:app": "node tools/release-app.ts",
    "release:publish": "node tools/publish-release.ts"
  },
  "engines": { "node": ">=22.18.0" },
  "dependencies": {
    "furifont": "0.6.2",
    "harfbuzzjs": "1.6.4",
    "kuromoji": "0.1.2",
    "ot-builder": "1.8.1",
    "pathkit-wasm": "1.0.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/kuromoji": "0.1.3",
    "@types/node": "24.10.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  }
}
