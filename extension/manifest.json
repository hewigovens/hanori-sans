{
  "manifest_version": 3,
  "name": "Hanori Reading Help",
  "version": "0.1.0",
  "description": "Local Japanese sentence readings, scoped corrections, and optional Hanori font mode.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png" },
  "action": {
    "default_popup": "popup.html", "default_title": "Hanori reading help",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" }
}
