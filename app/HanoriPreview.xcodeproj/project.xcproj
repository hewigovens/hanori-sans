{
  "default-configuration": "Debug",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "path": "Assets.xcassets", "target-membership": [ "HanoriPreview/resources" ] },
    { "path": "<PROJECT>/../licenses", "target-membership": [ "HanoriPreview/resources" ] },
    { "path": "<PROJECT>/../sources", "target-membership": [ "HanoriPreviewTests/resources" ] },
    {
      "kind": "group",
      "path": "../dist",
      "children": [
        { "path": "HanoriSans-Regular.otf", "target-membership": [ "HanoriPreview/resources" ] },
        { "path": "HanoriSansFurigana-Regular.otf", "target-membership": [ "HanoriPreview/resources" ] },
        { "path": "HanoriSerif-Regular.otf", "target-membership": [ "HanoriPreview/resources" ] },
        { "path": "HanoriSerifFurigana-Regular.otf", "target-membership": [ "HanoriPreview/resources" ] },
      ],
    }, {
      "kind": "group",
      "path": "Sources",
      "children": [
        {
          "kind": "group",
          "path": "App",
          "children": [
            { "path": "HanoriPreviewApp.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
            { "path": "MacAppDelegate.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
            { "path": "HanoriPreview.entitlements" },
          ],
        }, {
          "kind": "group",
          "path": "Models",
          "children": [
            { "path": "PreviewSettings.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Rendering",
          "children": [
            { "path": "SpecimenExporter.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
            { "path": "SpecimenLayout.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Services",
          "children": [
            { "path": "FontCatalog.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Views",
          "children": [
            { "path": "ContentView.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
            { "path": "ControlsView.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
            { "path": "PNGDocument.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
            { "path": "SampleMenu.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
            { "path": "SpecimenCard.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
            { "path": "SpecimenList.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
            { "path": "SpecimenView.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
            { "path": "TypographyControls.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
            {
              "kind": "group",
              "path": "Mobile",
              "children": [
                { "path": "AppearanceSheet.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
                { "path": "MobilePreviewView.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
                { "path": "TextEditorSheet.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
              ],
            },
            { "path": "SafariSetupView.swift", "target-membership": [ "HanoriPreview/compile-sources" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "Tests",
      "children": [
        { "path": "FontCompositionTests.swift", "target-membership": [ "HanoriPreviewTests/compile-sources" ] },
        { "path": "HanoriPreviewTests.swift", "target-membership": [ "HanoriPreviewTests/compile-sources" ] },
      ],
    }, {
      "kind": "group",
      "path": "UITests",
      "children": [
        { "path": "HanoriPreviewUITests.swift", "target-membership": [ "HanoriPreviewUITests/compile-sources" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/HanoriPreview.app", "id": "7A874A7E9A55F775FD0A2C0D", "index": false },
        { "path": "<PRODUCTS>/HanoriPreviewTests.xctest", "id": "E3D606D6718E5540679E0578", "index": false },
        { "path": "<PRODUCTS>/HanoriPreviewUITests.xctest", "id": "61EF546813C8FE81BA9C2162", "index": false },
        { "path": "<PRODUCTS>/HanoriSafariExtension.appex", "id": "1352479F31033AA766582272", "index": false, "target-membership": [ { "build-phase": "HanoriPreview/copy/Embed App Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
    { "path": "<PROJECT>/../build/extension-safari/dict", "target-membership": [ "HanoriSafariExtension/resources" ] },
    { "path": "<PROJECT>/../build/extension-safari/fonts", "target-membership": [ "HanoriSafariExtension/resources" ] },
    { "path": "<PROJECT>/../build/extension-safari/icons", "target-membership": [ "HanoriSafariExtension/resources" ] },
    { "path": "<PROJECT>/../build/extension-safari/licenses", "target-membership": [ "HanoriSafariExtension/resources" ] },
    {
      "kind": "group",
      "path": "Safari/Extension",
      "children": [
        { "path": "Info.plist" },
        { "path": "SafariWebExtensionHandler.swift", "target-membership": [ "HanoriSafariExtension/compile-sources" ] },
        { "path": "HanoriSafariExtension.entitlements" },
      ],
    }, {
      "kind": "group",
      "path": "../build/extension-safari",
      "children": [
        { "path": "automatic.js", "target-membership": [ "HanoriSafariExtension/resources" ] },
        { "path": "background.js", "target-membership": [ "HanoriSafariExtension/resources" ] },
        { "path": "manifest.json", "target-membership": [ "HanoriSafariExtension/resources" ] },
        { "path": "popup.css", "target-membership": [ "HanoriSafariExtension/resources" ] },
        { "path": "popup.html", "target-membership": [ "HanoriSafariExtension/resources" ] },
        { "path": "popup.js", "target-membership": [ "HanoriSafariExtension/resources" ] },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        {
          "path": "<SDK>/System/Library/Frameworks/SafariServices.framework",
          "target-membership": [
            "HanoriPreview/frameworks",
            "HanoriSafariExtension/frameworks",
          ],
        },
      ],
    },
  ],
  "targets": [
    {
      "name": "HanoriPreview",
      "id": "D2F18F9809AC3E0590F6808B",
      "product": "Products/HanoriPreview.app",
      "product-type": "application",
      "legacy-provisioning-style": "automatic",
      "dependencies": [
        "HanoriSafariExtension",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed App Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "Sources/App/HanoriPreview.entitlements",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_USER_SELECTED_FILES": "readwrite",
        "INFOPLIST_KEY_CFBundleDisplayName": "Hanori Preview",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.developer-tools",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "me.hanori.preview",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "HanoriPreviewTests",
      "id": "9678DCDFD034EC0C6BEC7608",
      "product": "Products/HanoriPreviewTests.xctest",
      "product-type": "bundle.unit-test",
      "legacy-provisioning-style": "automatic",
      "dependencies": [
        "HanoriPreview",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "me.hanori.HanoriPreviewTests",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/HanoriPreview.app/HanoriPreview",
        "TEST_HOST[sdk=macosx*]": "$(BUILT_PRODUCTS_DIR)/HanoriPreview.app/Contents/MacOS/HanoriPreview",
      },
    }, {
      "name": "HanoriPreviewUITests",
      "id": "45C296F39F17AC0B3300E0A6",
      "product": "Products/HanoriPreviewUITests.xctest",
      "product-type": "bundle.ui-testing",
      "legacy-provisioning-style": "automatic",
      "test-host-target": "HanoriPreview",
      "dependencies": [
        "HanoriPreview",
      ],
      "build-phases": [
        "compile-sources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "me.hanori.HanoriPreviewUITests",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_TARGET_NAME": "HanoriPreview",
      },
    }, {
      "name": "HanoriSafariExtension",
      "id": "4A9ABAE65009A86DE03047D0",
      "product": "Products/HanoriSafariExtension.appex",
      "product-type": "app-extension",
      "legacy-provisioning-style": "automatic",
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "Safari/Extension/HanoriSafariExtension.entitlements",
        "ENABLE_APP_SANDBOX": "YES",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "Safari/Extension/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "me.hanori.preview.safari",
        "SDKROOT": "auto",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++14",
    "CLANG_CXX_LIBRARY": "libc++",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "CODE_SIGN_STYLE": "Automatic",
    "COPY_PHASE_STRIP": "NO",
    "CURRENT_PROJECT_VERSION": "5",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu11",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "$(inherited)",
      "DEBUG=1",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "GENERATE_INFOPLIST_FILE": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
    "MACOSX_DEPLOYMENT_TARGET": "14.0",
    "MARKETING_VERSION": "0.1.4",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "SDKROOT": "auto",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_VERSION": "5.0",
  },
  "last-upgrade": "14.3",
}
